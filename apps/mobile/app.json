{
  "expo": {
    "name": "EduWay",
    "slug": "edudriver",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "scheme": "eduway",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pleimer.eduway"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pleimer.eduway",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EduWay uses your location during a drive to check speed limits, stop signs, and draw your route."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "EduWay uses motion sensors during a drive to detect hard braking, sharp turns, and swerves."
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-font",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DriveWidget",
              "displayName": "Start drive",
              "description": "One tap starts an EduWay drive.",
              "ios": { "supportedFamilies": ["systemSmall"] },
              "android": null
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "DriveWidget",
              "label": "Start drive",
              "description": "One tap starts an EduWay drive.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b2d0fa72-491f-4eb3-b7ef-d194cd8e8b6a"
      }
    },
    "owner": "pleimer",
    "updates": {
      "url": "https://u.expo.dev/b2d0fa72-491f-4eb3-b7ef-d194cd8e8b6a"
    }
  }
}
