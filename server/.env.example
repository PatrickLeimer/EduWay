# Copy to server/.env (never commit .env). Variable names only; ask the team for values.

PORT=4000

# MongoDB Atlas connection string. Needed for `npm run db:setup` and USE_REAL_DB=true.
MONGODB_URI=
MONGODB_DB=edudriver

GEMINI_API_KEY=
# Gemini model id (WS4 picks at the event).
GEMINI_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Street View (master doc section 12). Server-only; never put these in the app.
# Street View Static API + metadata. Restrict the key to the Street View Static API.
GOOGLE_STREETVIEW_KEY=
# Maps JavaScript API, used only by the panorama page this server serves. Restrict the key to
# the Maps JavaScript API and, by HTTP referrer, to this backend's domain (plus your LAN URL while testing).
GOOGLE_MAPS_JS_KEY=

# Public base URL of this server, used to build debrief audio links (open decision, see docs/workstreams.md).
PUBLIC_BASE_URL=

# Module switches: false = mock (default), true = real implementation.
USE_REAL_DB=false
USE_REAL_SCORING=false
USE_REAL_COACH=false
