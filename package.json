{
  "name": "edudriver",
  "version": "1.0.0",
  "private": true,
  "description": "Phone-only driving coach for student drivers. See docs/driving-coach-master.md.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspace @edudriver/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "npm run dev --workspace @edudriver/server",
    "dev:mobile": "npm run start --workspace @edudriver/mobile",
    "db:setup": "npm run db:setup --workspace @edudriver/server",
    "alert-clips": "tsx scripts/alert-clips/generate.ts",
    "drive-replay": "tsx scripts/drive-replay/replay.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
